<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PodBridge.App.Views.BannerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PodBridge.App.Views">

    <Grid x:Name="ThemeRoot">
        <Viewbox x:Name="ScaleBox" Stretch="Fill">
            <Grid x:Name="RootGrid" Width="340" Height="76" Padding="16,0,20,0"
                  PointerPressed="RootGrid_PointerPressed">
                <Grid ColumnSpacing="14" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="GlyphDisc" Grid.Column="0" Width="48" Height="48" CornerRadius="24">
                        <local:EarbudGlyph x:Name="Bud" Height="30" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailText" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Ellipse x:Name="StateDot" Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
