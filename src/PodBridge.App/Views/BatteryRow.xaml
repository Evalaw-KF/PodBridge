<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PodBridge.App.Views.BatteryRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="6" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="56" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="LabelText" Grid.Column="0" VerticalAlignment="Center"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />
        <ProgressBar x:Name="Bar" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                     VerticalAlignment="Center" />
        <TextBlock x:Name="ValueText" Grid.Column="2" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <TextBlock x:Name="DetailText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                   Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</UserControl>
