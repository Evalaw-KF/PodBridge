<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PodBridge.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PodBridge.App.Views">

    <ScrollViewer>
        <StackPanel Padding="24,8,24,24" Spacing="16">

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="PictureImage" Grid.Column="0" Width="64" Height="64" Stretch="UniformToFill"
                       Visibility="Collapsed" VerticalAlignment="Center" />
                <FontIcon x:Name="DefaultPicture" Grid.Column="0" Glyph="&#xE7F6;" FontSize="40"
                          VerticalAlignment="Center" Opacity="0.7" />
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceName" Style="{StaticResource TitleTextBlockStyle}"
                               TextWrapping="Wrap" Text="Looking for your AirPods" />
                    <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap"
                               Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="22">
                    <local:BatteryRow x:Name="LeftRow" />
                    <local:BatteryRow x:Name="RightRow" />
                    <local:BatteryRow x:Name="CaseRow" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Audio" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="AudioStatusText" TextWrapping="Wrap" Opacity="0.8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" />
                        <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click" />
                        <Button x:Name="SwitchOutputButton" Content="Switch output" Click="SwitchOutputButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="AudioMessageText" TextWrapping="Wrap" Opacity="0.7"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Tips" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Open the case lid near your PC, or put an earbud in your ear, and PodBridge will pick up the battery levels. Nothing needs to be paired with this app." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SpeakerButton" Content="Speaker mode" Click="SpeakerButton_Click" />
                <Button x:Name="SettingsButton" Content="Settings" Click="SettingsButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
