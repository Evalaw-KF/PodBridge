<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PodBridge.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PodBridge.App.Views">

    <ScrollViewer>
        <StackPanel Padding="24,8,24,24" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock x:Name="DeviceName" Style="{StaticResource TitleTextBlockStyle}"
                           TextWrapping="Wrap" Text="Looking for your AirPods" />
                <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="22">
                    <local:BatteryRow x:Name="LeftRow" />
                    <local:BatteryRow x:Name="RightRow" />
                    <local:BatteryRow x:Name="CaseRow" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Tips" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Open the case lid near your PC, or put an earbud in your ear, and PodBridge will pick up the battery levels. Nothing needs to be paired with this app." />
                </StackPanel>
            </Border>

            <Button x:Name="SettingsButton" Content="Settings" HorizontalAlignment="Left"
                    Click="SettingsButton_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
