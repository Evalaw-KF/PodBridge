<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PodBridge.App.Views.EarbudGlyph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!-- A simple stylised earbud (round head, short stem) drawn with plain shapes. Set Height to scale it. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="30" Height="50">
            <Rectangle x:Name="StemShape" Canvas.Left="15" Canvas.Top="16" Width="10" Height="34"
                       RadiusX="5" RadiusY="5" />
            <Ellipse x:Name="HeadShape" Canvas.Left="0" Canvas.Top="0" Width="28" Height="28" />
            <Ellipse x:Name="DetailShape" Canvas.Left="6" Canvas.Top="9" Width="9" Height="9" />
        </Canvas>
    </Viewbox>
</UserControl>
