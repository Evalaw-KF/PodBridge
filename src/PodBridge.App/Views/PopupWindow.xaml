<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PodBridge.App.Views.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PodBridge.App.Views">

    <!--
      ThemeRoot is the window's content root: it carries RequestedTheme and a solid background (set in code from the
      palette). The Viewbox scales the fixed-size card with the pop-up size setting.
    -->
    <Grid x:Name="ThemeRoot">
        <Viewbox x:Name="ScaleBox" Stretch="Fill">
            <Grid x:Name="RootGrid" Width="360" Height="200" Padding="20,16,20,14"
                  CornerRadius="24" BorderThickness="1" PointerPressed="RootGrid_PointerPressed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <Grid Grid.Row="1" Height="40" Margin="0,8,0,0">
                    <Image x:Name="PictureImage" Height="40" Stretch="Uniform" Visibility="Collapsed"
                           HorizontalAlignment="Center" />
                    <local:PodsArt x:Name="DefaultArt" Height="40" HorizontalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="34" Margin="0,6,0,0">
                    <local:BatteryRing x:Name="LeftRing" />
                    <local:BatteryRing x:Name="RightRing" />
                    <local:BatteryRing x:Name="CaseRing" />
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
