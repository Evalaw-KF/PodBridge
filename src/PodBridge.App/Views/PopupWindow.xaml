<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PodBridge.App.Views.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Padding="20,16" PointerPressed="RootGrid_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextTrimming="CharacterEllipsis" />

        <Grid Grid.Row="1" Margin="0,10,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                <TextBlock x:Name="LeftValue" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="LeftLabel" Text="Left" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                <TextBlock x:Name="RightValue" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="RightLabel" Text="Right" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                <TextBlock x:Name="CaseValue" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="CaseLabel" Text="Case" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
