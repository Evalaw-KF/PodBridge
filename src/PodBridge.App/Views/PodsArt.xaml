<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PodBridge.App.Views.PodsArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PodBridge.App.Views"
    IsTabStop="False">

    <!-- Two earbuds and a charging case, drawn with shapes. Set Height to scale the whole picture. -->
    <Viewbox Stretch="Uniform">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
            <local:EarbudGlyph x:Name="LeftBud" Height="50" VerticalAlignment="Bottom" />
            <Grid Width="50" Height="42" VerticalAlignment="Bottom">
                <Border x:Name="CaseBody" CornerRadius="15" />
                <Rectangle x:Name="CaseLid" Height="1.5" VerticalAlignment="Top" Margin="0,14,0,0" />
                <Ellipse x:Name="CaseLed" Width="5" Height="5" VerticalAlignment="Bottom" Margin="0,0,0,8" />
            </Grid>
            <local:EarbudGlyph x:Name="RightBud" Height="50" VerticalAlignment="Bottom"
                               RenderTransformOrigin="0.5,0.5">
                <local:EarbudGlyph.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </local:EarbudGlyph.RenderTransform>
            </local:EarbudGlyph>
        </StackPanel>
    </Viewbox>
</UserControl>
