<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PodBridge.App.Views.BatteryRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!-- A circular battery gauge: grey track, coloured arc (drawn in code from Core's ring maths), percent inside. -->
    <StackPanel HorizontalAlignment="Center" Spacing="6">
        <Grid x:Name="RingHost" Width="64" Height="64" HorizontalAlignment="Center">
            <Ellipse x:Name="TrackRing" StrokeThickness="6" />
            <Path x:Name="ArcPath" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                <TextBlock x:Name="ValueText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <FontIcon x:Name="BoltIcon" Glyph="&#xE945;" FontSize="10" HorizontalAlignment="Center"
                          Visibility="Collapsed" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="LabelText" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock x:Name="DetailText" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
