<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PodBridge.App.Views.OutputPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="ThemeRoot">
        <Viewbox x:Name="ScaleBox" Stretch="Fill">
            <Grid x:Name="RootGrid" Width="360" Height="112" Padding="22,14,22,14"
                  PointerEntered="RootGrid_PointerEntered"
                  PointerExited="RootGrid_PointerExited"
                  PointerMoved="RootGrid_PointerMoved">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon x:Name="TitleIcon" Glyph="&#xE767;" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" MaxWidth="280"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="LowIcon" Grid.Column="0" Glyph="&#xE992;" FontSize="14" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1"
                            VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                    <FontIcon x:Name="HighIcon" Grid.Column="2" Glyph="&#xE995;" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="VolumeText" Grid.Column="3" MinWidth="40" TextAlignment="Right"
                               VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
