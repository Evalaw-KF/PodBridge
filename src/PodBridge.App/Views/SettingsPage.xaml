<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PodBridge.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,8,24,24" Spacing="16">

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BackButton" Content="Back" Click="BackButton_Click" />
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Low battery" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="NotifyToggle" Header="Show a notification when battery is low"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ThresholdLabel" Text="Warn me at 20%" />
                        <Slider x:Name="ThresholdSlider" Minimum="5" Maximum="50" StepFrequency="5"
                                TickFrequency="5" TickPlacement="Outside"
                                ValueChanged="ThresholdSlider_ValueChanged" />
                    </StackPanel>
                    <Button x:Name="TestNotificationButton" Content="Send a test notification"
                            Click="TestNotificationButton_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Pop-up" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="PopupToggle" Header="Show a pop-up when the case lid opens"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <Button x:Name="PreviewPopupButton" Content="Preview the pop-up"
                            Click="PreviewPopupButton_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="StartupToggle" Header="Start PodBridge with Windows"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <ComboBox x:Name="ThemeCombo" Header="Theme" MinWidth="200"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Use system setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Diagnostics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="The last distinct Bluetooth adverts (newest first): time, signal, raw bytes and the decoded status byte. Put an earbud in your ear and copy this if the in-ear status looks wrong." />
                    <TextBox x:Name="AdvertText" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" Height="240"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <Button x:Name="CopyAdvertsButton" Content="Copy to clipboard"
                            Click="CopyAdvertsButton_Click" />
                    <TextBlock x:Name="AdvertFileText" TextWrapping="Wrap" Opacity="0.6" IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <TextBlock Opacity="0.6" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="PodBridge works entirely offline. It only listens to Bluetooth broadcasts from nearby AirPods and Beats and never sends data anywhere." />
        </StackPanel>
    </ScrollViewer>
</Page>
