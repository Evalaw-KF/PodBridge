<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PodBridge.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,8,24,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BackButton" Content="Back" Click="BackButton_Click" />
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Low battery" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="NotifyToggle" Header="Show a notification when battery is low"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ThresholdLabel" Text="Warn me at 20%" />
                        <Slider x:Name="ThresholdSlider" Minimum="5" Maximum="50" StepFrequency="5"
                                TickFrequency="5" TickPlacement="Outside"
                                ValueChanged="ThresholdSlider_ValueChanged" />
                    </StackPanel>
                    <Button x:Name="TestNotificationButton" Content="Send a test notification"
                            Click="TestNotificationButton_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Pop-up" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="PopupToggle" Header="Show a pop-up when the case lid opens"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <ComboBox x:Name="PopupSizeCombo" Header="Pop-up size" MinWidth="200"
                              SelectionChanged="PopupLook_SelectionChanged">
                        <ComboBoxItem Content="Small" />
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Large" />
                    </ComboBox>
                    <ComboBox x:Name="PopupPositionCombo" Header="Pop-up position" MinWidth="200"
                              SelectionChanged="PopupLook_SelectionChanged">
                        <ComboBoxItem Content="Bottom right" />
                        <ComboBoxItem Content="Bottom centre" />
                        <ComboBoxItem Content="Top right" />
                        <ComboBoxItem Content="Top centre" />
                    </ComboBox>
                    <Button x:Name="PreviewPopupButton" Content="Preview the pop-up"
                            Click="PreviewPopupButton_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Headphone picture" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="Optional. Choose your own picture (PNG, JPG, BMP or GIF, up to 10 MB). It is copied into PodBridge's own folder and shown in the main window and the pop-up." />
                    <Image x:Name="PicturePreview" Width="72" Height="72" Stretch="UniformToFill"
                           HorizontalAlignment="Left" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ChoosePictureButton" Content="Choose a picture..." Click="ChoosePictureButton_Click" />
                        <Button x:Name="ResetPictureButton" Content="Reset" Click="ResetPictureButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PictureMessage" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Read notifications aloud" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="ReadAloudToggle" Header="Speak Windows notifications through my AirPods"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <TextBlock x:Name="ReadAccessText" TextWrapping="Wrap" Opacity="0.8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AllowAccessButton" Content="Allow access" Click="AllowAccessButton_Click" />
                        <Button x:Name="OpenNotificationSettingsButton" Content="Open Windows notification settings"
                                Click="OpenNotificationSettingsButton_Click" />
                    </StackPanel>
                    <StackPanel x:Name="ReadOptionsPanel" Spacing="12">
                        <ToggleSwitch x:Name="InEarToggle" Header="Only read while my AirPods are in my ear"
                                      OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                        <ToggleSwitch x:Name="FullTextToggle" Header="Read the whole message (off: app name and title only)"
                                      OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                        <ComboBox x:Name="VoiceCombo" Header="Voice" MinWidth="280"
                                  SelectionChanged="VoiceCombo_SelectionChanged" />
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RateLabel" Text="Speed 100%" />
                            <Slider x:Name="RateSlider" Minimum="50" Maximum="200" StepFrequency="10"
                                    ValueChanged="RateSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SpeechVolumeLabel" Text="Volume 80%" />
                            <Slider x:Name="SpeechVolumeSlider" Minimum="10" Maximum="100" StepFrequency="5"
                                    ValueChanged="SpeechVolumeSlider_ValueChanged" />
                        </StackPanel>
                        <Button x:Name="TestSpeechButton" Content="Hear a sample" Click="TestSpeechButton_Click" />
                        <TextBlock Text="Apps to read" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="AppsHelpText" TextWrapping="Wrap" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="Only ticked apps are read. Apps appear here after they show a notification while this is switched on." />
                        <StackPanel x:Name="AppsPanel" Spacing="2" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="Uses the voices installed on your PC, so nothing is sent to the internet. Add more voices in Windows Settings > Time and language > Speech." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Ear detection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="AutoPauseToggle" Header="Pause media when an earbud comes out"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <ToggleSwitch x:Name="ResumeToggle" Header="Resume when the earbuds go back in (only if PodBridge paused it)"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <ToggleSwitch x:Name="OneBudToggle" Header="I usually wear only one earbud"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="Needs a player that supports Windows media controls (Spotify, browsers, Windows Media Player and most others do). Changes must last about 1.5 seconds to count." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Audio output" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox x:Name="NameMatchBox" Header="Headphone name match" MaxLength="60"
                             PlaceholderText="AirPods" LostFocus="NameMatchBox_LostFocus" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="PodBridge finds your AirPods' audio device by looking for this text in its name (for example the name you gave your AirPods)." />
                    <ToggleSwitch x:Name="AutoSwitchToggle" Header="Switch to my speakers when both earbuds are out, and back when one goes in"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <ComboBox x:Name="FallbackCombo" Header="Speakers to switch to" MinWidth="280"
                              SelectionChanged="FallbackCombo_SelectionChanged" />
                    <ToggleSwitch x:Name="OutputPopupToggle" Header="Show a volume pop-up when the output changes"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <ToggleSwitch x:Name="BannerToggle" Header="Show connect/disconnect banner"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <ToggleSwitch x:Name="KeepAliveToggle" Header="Keep the AirPods awake with inaudible silence"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="Keep-awake stops the first moment of a sound from being cut off. It plays only while the AirPods are your output." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Shortcuts" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="HotkeysToggle" Header="Use global keyboard shortcuts"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <TextBox x:Name="ConnectHotkeyBox" Header="Connect / disconnect AirPods" IsReadOnly="True"
                             PlaceholderText="Click here, then press a shortcut"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                    <TextBlock x:Name="ConnectHotkeyStatus" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    <TextBox x:Name="SwitchHotkeyBox" Header="Switch output (AirPods / speakers)" IsReadOnly="True"
                             PlaceholderText="Click here, then press a shortcut"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                    <TextBlock x:Name="SwitchHotkeyStatus" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="Use Ctrl, Alt or Win with a key. Press Backspace in a box to clear it." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="StartupToggle" Header="Start PodBridge with Windows"
                                  OnContent="On" OffContent="Off" Toggled="Setting_Changed" />
                    <ComboBox x:Name="ThemeCombo" Header="Theme" MinWidth="200"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Use system setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Diagnostics" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                               Text="The last distinct Bluetooth adverts (newest first): time, signal, raw bytes and the decoded status byte. Put an earbud in your ear and copy this if the in-ear status looks wrong." />
                    <TextBox x:Name="AdvertText" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" Height="240"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <Button x:Name="CopyAdvertsButton" Content="Copy to clipboard"
                            Click="CopyAdvertsButton_Click" />
                    <TextBlock x:Name="AdvertFileText" TextWrapping="Wrap" Opacity="0.6" IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <TextBlock Opacity="0.6" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="PodBridge works entirely offline. It only listens to Bluetooth broadcasts from nearby AirPods and Beats and never sends data anywhere." />
        </StackPanel>
    </ScrollViewer>
</Page>
